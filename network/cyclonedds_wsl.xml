<?xml version="1.0" encoding="utf-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <!-- ROS 2 runs entirely inside one WSL instance. Keep DDS discovery and
           topic traffic on the real loopback interface; raw TCP to the Pi is
           independent and continues to use the hotspot-facing eth0. -->
      <Interfaces>
        <NetworkInterface name="lo" multicast="true" />
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>
